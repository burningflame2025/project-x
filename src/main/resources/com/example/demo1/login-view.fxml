<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #15202b;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.View.LoginViewController">

    <padding>
        <Insets bottom="50" left="50" right="50" top="50" />
    </padding>

    <VBox alignment="CENTER" spacing="10">
        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 32px; -fx-font-weight: bold;" text="X" />
        <Label style="-fx-text-fill: #8899a6; -fx-font-size: 16px;" text="Login to your account" />
    </VBox>

    <VBox alignment="CENTER" maxWidth="400" spacing="15" style="-fx-background-color: #192734; -fx-background-radius: 20px; -fx-padding: 30px;">

        <VBox spacing="8">
            <Label style="-fx-text-fill: #8899a6; -fx-font-size: 13px;" text="Username" />
            <TextField fx:id="txtUsername" promptText="Enter username" style="-fx-background-color: #253341; -fx-text-fill: white; -fx-background-radius: 15px; -fx-padding: 12px 15px;" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-text-fill: #8899a6; -fx-font-size: 13px;" text="Password" />
            <PasswordField fx:id="txtPassword" promptText="Enter password" style="-fx-background-color: #253341; -fx-text-fill: white; -fx-background-radius: 15px; -fx-padding: 12px 15px;" />
        </VBox>

        <Label fx:id="lblMessage" style="-fx-font-size: 13px;" wrapText="true" />

        <HBox alignment="CENTER" spacing="15">
            <Button onAction="#handleLogin" prefWidth="120" style="-fx-background-color: #1da1f2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px 20px; -fx-cursor: hand;" text="Login" />
            <Button onAction="#handleRegister" prefWidth="120" style="-fx-background-color: transparent; -fx-text-fill: #1da1f2; -fx-border-color: #1da1f2; -fx-border-radius: 20px; -fx-background-radius: 20px; -fx-padding: 10px 20px; -fx-cursor: hand;" text="Sign Up" />
        </HBox>

        <Hyperlink onAction="#handleAdminLogin" style="-fx-text-fill: #8899a6; -fx-font-size: 12px; -fx-cursor: hand;" text="Admin Login Portal" />
    </VBox>

</VBox>